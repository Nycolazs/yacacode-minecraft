# ==============================================================================
# YacaCode Minecraft Server — Configuração de Produção (Orange Pi 4GB ARM64)
# ==============================================================================
# Copie este arquivo para `.env` ou execute:  ./scripts/configure.sh
# NUNCA compartilhe ou faça commit do arquivo `.env` preenchido!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERFIS ATIVOS DO DOCKER COMPOSE
# ------------------------------------------------------------------------------
# - backup     : Backups automáticos seguros com RCON (recomendado sempre)
# - cloudflare : Expõe o Painel Admin na internet com HTTPS via Cloudflare Tunnel
# - ddns       : Sincroniza seu domínio na Cloudflare com o IP público do Orange Pi
#
# Para testar localmente ANTES de configurar a Cloudflare, use apenas:
#   COMPOSE_PROFILES=backup
COMPOSE_PROFILES=backup,cloudflare,ddns

# Fuso horário (afeta logs, backups e agendamentos)
TZ=America/Fortaleza

# ------------------------------------------------------------------------------
# 2. IDENTIDADE & REDE DO SERVIDOR YACACODE
# ------------------------------------------------------------------------------
SERVER_NAME=YacaCode

# Domínio onde os jogadores vão conectar (Java e Bedrock)
# Ex: mc.yacacode.com ou jogar.yacacode.com
# IMPORTANTE: Na Cloudflare, este registro A deve ficar com Proxy DESLIGADO (nuvem cinza / DNS Only)
MC_DOMAIN=mc.yacacode.com

# Domínio do Painel Admin exposto via Cloudflare Tunnel (Zero Trust HTTPS)
# Ex: painel.yacacode.com ou admin.mc.yacacode.com
PANEL_DOMAIN=painel.yacacode.com

# Portas do jogo (libere estas portas no roteador/Port Forwarding para o IP local do Orange Pi)
MC_JAVA_PORT=25565
MC_BEDROCK_PORT=19132

# ------------------------------------------------------------------------------
# 3. MINECRAFT PAPER 26.3 (JAVA 25) + CROSSPLAY BEDROCK (GEYSER + FLOODGATE)
# ------------------------------------------------------------------------------
# Versão do PaperMC: "26.3" (mais recente estável) ou "LATEST" para atualizar automaticamente
MC_VERSION=26.3

# Orçamento de RAM tunado para Orange Pi Zero 2W de 4GB (até 6 jogadores frios e lisos)
# Com Java 25 + CompactObjectHeaders (-XX:+UseCompactObjectHeaders), 2.0GB rende como ~2.5GB
# e deixa ~1.8GB livre no sistema com ciclos de GC muito mais rápidos e frios!
MC_INIT_MEMORY=1024M
MC_MAX_MEMORY=2048M
MC_MEM_LIMIT=2560m

# Jogabilidade & Desempenho 24/7 (Otimizado para até 6 jogadores)
MC_DIFFICULTY=normal
MC_GAMEMODE=survival
MC_MAX_PLAYERS=6
MC_VIEW_DISTANCE=6
MC_SIMULATION_DISTANCE=4
MC_PVP=true
MC_ONLINE_MODE=true
MC_WHITELIST=false

# MOTD exibido na lista de servidores Java
MC_MOTD=\u00A7a\u00A7lYacaCode \u00A78| \u00A76Minecraft 26.3\n\u00A77Java & Bedrock Crossplay \u00A78\u2022 \u00A7ayacacode.com

# Plugins extras do Modrinth (separados por vírgula ou quebra de linha)
# Padrão: chunky (pré-geração de chunks — essencial para 20 TPS no Orange Pi!)
# Opcional para aceitar versões Java mais antigas: chunky,viaversion,viabackwards
MC_MODRINTH_PLUGINS=chunky

# Senha interna do RCON (GERAR SENHA FORTE COM ./scripts/configure.sh)
# Nota: a porta RCON (25575) fica 100% isolada na rede interna do Docker.
RCON_PASSWORD=TROQUE_POR_UMA_SENHA_RCON_MUITO_FORTE

# ------------------------------------------------------------------------------
# 4. PAINEL ADMIN YACACODE (EXPOSTO VIA CLOUDFLARE TUNNEL)
# ------------------------------------------------------------------------------
# IP de bind local no Orange Pi:
# - 127.0.0.1 : Recomendado! Acesso externo EXCLUSIVO via Cloudflare Tunnel (máxima segurança)
# - 0.0.0.0   : Permite também acesso direto pela rede local (ex: http://IP_DO_ORANGEPI:8080)
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=8080

# Credenciais de login do Painel Admin YacaCode
PANEL_ADMIN_USER=admin
# Use o hash gerado por ./scripts/configure.sh (formato scrypt$salt$hash) OU senha em texto para 1º uso
PANEL_ADMIN_PASSWORD_HASH=
PANEL_ADMIN_PASSWORD=TROQUE_ESTA_SENHA_ADMIN

# Segredo para assinatura HMAC dos cookies de sessão (mín. 32 chars aleatórios)
PANEL_SESSION_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Se você ativar Cloudflare Zero Trust Access sobre painel.yacacode.com, mude para true
# para exibir o badge de autenticação Zero Trust e aceitar o header Cf-Access-Authenticated-User-Email
CF_ACCESS_ENABLED=false

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE TUNNEL (PAINEL ADMIN NA INTERNET COM HTTPS)
# ------------------------------------------------------------------------------
# Obtenha em: Cloudflare Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Docker
# No Public Hostname do Tunnel, aponte:
#   Subdomain: painel  |  Domain: yacacode.com  |  Service: HTTP -> yacacode-panel:8080
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE DDNS (DOMÍNIO CONECTADO AO IP DO SERVIDOR AUTOMATICAMENTE)
# ------------------------------------------------------------------------------
# Crie um API Token em: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token
# Template: "Edit zone DNS" -> Permissões: Zone / DNS / Edit -> Zona: seu domínio
CLOUDFLARE_DNS_API_TOKEN=

# IPv6 DDNS: "none" (recomendado para evitar problemas de roteador residencial) ou "cloudflare.doh"
DDNS_IP6_PROVIDER=none

# ------------------------------------------------------------------------------
# 7. BACKUPS AUTOMÁTICOS 24/7
# ------------------------------------------------------------------------------
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_COUNT=10

# ------------------------------------------------------------------------------
# 8. ASSISTENTE IA GEMINI NO PAINEL (OPCIONAL — PODE CONFIGURAR DIRETO NO PAINEL)
# ------------------------------------------------------------------------------
# Chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 8. MONITORAMENTO & ALERTAS (OPCIONAL — usado por scripts/watchdog.sh)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
MAX_TEMP_ALERT_C=78
