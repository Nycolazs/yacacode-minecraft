+/// Vanilla `AbstractSkeleton.finalizeSpawn`: the bow (or the wither skeleton's sword), armor and
+/// their enchantments. Without it naturally spawned skeletons had empty hands, since the natural
+/// spawner never runs `init_data_tracker` (which only equips spawn-egg/command spawns).
+pub fn finalize_skeleton_spawn<M: Mob>(
+    mob: &M,
+    world: &Arc<World>,
+    group_data: Option<crate::entity::mob::spawn::SpawnGroupData>,
+) -> Option<crate::entity::mob::spawn::SpawnGroupData> {
+    let difficulty = RegionalDifficulty::at(world, mob.get_entity().pos.load());
+    mob.populate_default_equipment_slots(world, &difficulty);
+    mob.populate_default_equipment_enchantments(&difficulty);
+    mob.default_finalize_spawn(world, group_data)
+}
