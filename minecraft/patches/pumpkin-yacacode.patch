+    #[test]
+    fn pbkdf2_rfc7914_vector() {
+        // RFC 7914 §11: PBKDF2-HMAC-SHA256(P="passwd", S="salt", c=1, dkLen=64) — primeiros 32 bytes
+        assert_eq!(
+            hex(&pbkdf2(b"passwd", b"salt", 1)),
+            "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc"
+        );
+        // c=80000, P="Password", S="NaCl"
+        assert_eq!(
+            hex(&pbkdf2(b"Password", b"NaCl", 80000)),
+            "4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56"
+        );
+    }
+
+    #[test]
+    fn entry_roundtrip_and_account_key() {
+        let e = new_entry("segredo123");
+        assert!(check_password(&e, "segredo123"));
+        assert!(!check_password(&e, "segredo124"));
+        assert_eq!(account_key(".Nycolazs"), "nycolazs");
+        assert_eq!(account_key("Nycolazs"), "nycolazs");
+    }
